rules_version = '2';
// かぞく手帳 + バレットジャーナル 用の Firestore セキュリティルール
// (かぞく手帳と同じFirebaseプロジェクトを使うため、1つのルールにまとめています)
// 家族ドキュメントの emails に入っているメールアドレスでログインし、
// そのメールアドレスの確認（メール内リンクのクリック）を済ませた人だけが、その家族のデータを読み書きできます。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isFamilyMember(fid) {
      return signedIn() &&
        myEmail() in get(/databases/$(database)/documents/families/$(fid)).data.emails;
    }

    // ---- バレットジャーナル用: 自分(uid)のデータだけ、メール確認済みのアカウントだけ読み書きできる ----
    match /users/{uid}/{col}/{docId} {
      allow read, write: if signedIn()
        && request.auth.uid == uid
        && col in ['entries', 'wishes', 'shop', 'places', 'trades', 'genres', 'config'];
    }

    match /families/{fid} {
      allow read: if signedIn() && myEmail() in resource.data.emails;
      allow create: if signedIn()
        && request.resource.data.emails is list
        && myEmail() in request.resource.data.emails
        && request.resource.data.emails.size() <= 20;
      allow update: if signedIn() && myEmail() in resource.data.emails
        && request.resource.data.emails is list
        && request.resource.data.emails.size() <= 20;
      allow delete: if false;

      match /{col}/{docId} {
        allow read, write: if col in ['members', 'events', 'notes', 'bucket', 'tx', 'holdings', 'receipts', 'config']
          && isFamilyMember(fid);
      }
    }
  }
}
